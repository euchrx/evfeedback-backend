generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  COMPANY_ADMIN
  MANAGER
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(COMPANY_ADMIN)
  active       Boolean  @default(true)
  companyId    String?
  company      Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Company {
  id        String    @id @default(cuid())
  name      String
  active    Boolean   @default(true)
  users     User[]
  branches  Branch[]
  kiosks    Kiosk[]
  feedbacks Feedback[]
  tags      Tag[]
  setting   Setting?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Branch {
  id        String     @id @default(cuid())
  name      String
  code      String?    @unique
  active    Boolean    @default(true)
  companyId String
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kiosks    Kiosk[]
  feedbacks Feedback[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Kiosk {
  id                  String          @id @default(cuid())
  name                String
  token               String          @unique
  locationDescription String?
  active              Boolean         @default(true)
  companyId           String
  company             Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId            String
  branch              Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  feedbacks           Feedback[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
}

model Tag {
  id              String          @id @default(uuid())
  name            String
  color           String?
  active          Boolean         @default(true)
  companyId       String
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items           FeedbackTag[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model Feedback {
  id             String        @id @default(cuid())
  rating         Int
  comment        String?
  contactName    String?
  contactPhone   String?
  contactMessage String?
  contactConsent Boolean       @default(false)
  companyId      String
  kioskId        String
  branchId       String
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kiosk          Kiosk         @relation(fields: [kioskId], references: [id], onDelete: Cascade)
  branch         Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tags           FeedbackTag[]
  createdAt      DateTime      @default(now())
}

model FeedbackTag {
  id         String   @id @default(cuid())
  feedbackId String
  tagId      String
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([feedbackId, tagId])
}

model Setting {
  id                        String   @id @default(cuid())
  companyId                 String   @unique
  company                   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyName               String?
  logoUrl                   String?
  thankYouMessage           String?
  primaryColor              String?
  kioskResetSeconds         Int      @default(5)
  heroTitle                 String?
  heroSubtitle              String?
  backgroundColor           String?
  backgroundImageUrl        String?
  cardBackgroundColor       String?
  textColor                 String?
  buttonTextColor           String?
  notificationEmails        String?
  dailyNotificationEnabled  Boolean  @default(true)
  monthlyNotificationEnabled Boolean @default(true)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}